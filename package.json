// ============================================================================
// STATE INITIALIZATION & PERSISTENCE
// ============================================================================

function createInitialState() {
  return {
    version: 1,
    started: false,
    businessType: null,
    businessName: 'My New Venture',
    money: 650,
    totalEarned: 0,
    lifetimeEarnings: 0,
    reputation: 2.5,
    stage: 1,
    prestigeLevel: 0,
    prestigeMultiplier: 1,
    day: 1,
    hour: 8,
    minute: 0,
    openHour: 7,
    closeHour: 20,
    priceMultiplier: 1.0,
    inventory: 120,
    maxInventory: 250,
    autoRestock: false,
    autoRestockThreshold: 25,
    workers: [],
    upgrades: {
      equipment_1: 0,
      capacity_1: 0,
      decor_1: 0,
      tech_1: 0,
      expansion_1: 0
    },
    loanBalance: 0,
    todayStats: {
      revenue: 0,
      cogs: 0,
      wages: 0,
      rent: 0,
      utilities: 0,
      marketing: 0,
      insurance: 0,
      customersServed: 0,
      lostSales: 0
    },
    history: [],
    milestones: [],
    reviews: [],
    activeEvent: null,
    soundEnabled: true,
    lastSavedAt: new Date().toISOString()
  };
}

let gameState = createInitialState();

try {
  if (fs.existsSync(AUTOSAVE_PATH)) {
    const raw = fs.readFileSync(AUTOSAVE_PATH, 'utf8');
    const parsed = JSON.parse(raw);
    if (parsed && typeof parsed === 'object' && 'money' in parsed) {
      gameState = { ...createInitialState(), ...parsed };
    }
  }
} catch {
  // Ignore corrupted autosave on startup
}

function persistAutoSave() {
  gameState.lastSavedAt = new Date().toISOString();
  try {
    fs.writeFileSync(AUTOSAVE_PATH, JSON.stringify(gameState, null, 2), 'utf8');
  } catch {
    // Non-fatal in read-only containers; in-memory state remains active
  }
}

setInterval(() => {
  if (gameState.started) {
    persistAutoSave();
  }
}, 30000);

// ============================================================================
// API ENDPOINTS
// ============================================================================

app.get('/', (_req, res) => {
  res.sendFile(path.join(__dirname, 'index.html'));
});

app.get('/api/status', (_req, res) => {
  res.json({ ok: true, state: gameState });
});

app.post('/api/choose-business', (req, res) => {
  const { businessType, businessName, switchMode } = req.body || {};
  const spec = BUSINESS_CATALOG[businessType];
  if (!spec) {
    return res.status(400).json({ ok: false, error: 'Invalid business type selected.' });
  }

  if (switchMode && gameState.started) {
    gameState.businessType = spec.id;
    gameState.businessName = (businessName && String(businessName).trim().slice(0, 40)) || spec.name;
    gameState.maxInventory = Math.round(spec.maxInventoryBase * STAGE_REQUIREMENTS[gameState.stage - 1].capacityMult);
    gameState.inventory = spec.usesInventory ? Math.min(gameState.maxInventory, Math.max(40, Math.round(gameState.maxInventory * 0.5))) : gameState.maxInventory;
    gameState.priceMultiplier = 1.0;
  } else {
    const mult = gameState.prestigeMultiplier || 1;
    const prestigeLvl = gameState.prestigeLevel || 0;
    const lifetime = gameState.lifetimeEarnings || 0;
    const milestones = Array.isArray(gameState.milestones) ? gameState.milestones : [];

    gameState = createInitialState();
    gameState.started = true;
    gameState.businessType = spec.id;
    gameState.businessName = (businessName && String(businessName).trim().slice(0, 40)) || spec.name;
    gameState.money = Math.round(spec.startingMoney * (1 + (mult - 1) * 0.25));
    gameState.maxInventory = spec.maxInventoryBase;
    gameState.inventory = spec.usesInventory ? Math.round(spec.maxInventoryBase * 0.6) : spec.maxInventoryBase;
    gameState.prestigeLevel = prestigeLvl;
    gameState.prestigeMultiplier = mult;
    gameState.lifetimeEarnings = lifetime;
    gameState.milestones = milestones;
  }

  persistAutoSave();
  res.json({ ok: true, state: gameState });
});

app.post('/api/upgrade', (req, res) => {
  const { upgradeId } = req.body || {};
  if (!gameState.started || !gameState.businessType) {
    return res.status(400).json({ ok: false, error: 'Start a business before purchasing upgrades.' });
  }

  if (upgradeId === 'advance_stage') {
    if (gameState.stage >= 5) {
      return res.status(400).json({ ok: false, error: 'Already at maximum Empire HQ stage.' });
    }
    const nextStageReq = STAGE_REQUIREMENTS[gameState.stage];
    if (gameState.money < nextStageReq.upgradeCost) {
      return res.status(400).json({ ok: false, error: `Need $${nextStageReq.upgradeCost.toLocaleString()} to expand.` });
    }
    if (gameState.reputation < nextStageReq.minRep) {
      return res.status(400).json({ ok: false, error: `Requires ${nextStageReq.minRep.toFixed(1)}★ reputation.` });
    }
    gameState.money -= nextStageReq.upgradeCost;
    gameState.stage += 1;
    const spec = BUSINESS_CATALOG[gameState.businessType];
    gameState.maxInventory = Math.round(spec.maxInventoryBase * STAGE_REQUIREMENTS[gameState.stage - 1].capacityMult);
    persistAutoSave();
    return res.json({ ok: true, state: gameState });
  }

  const upg = UPGRADE_CATALOG[upgradeId];
  if (!upg) {
    return res.status(400).json({ ok: false, error: 'Unknown upgrade ID.' });
  }

  const currentLevel = gameState.upgrades[upgradeId] || 0;
  if (currentLevel >= upg.maxLevel) {
    return res.status(400).json({ ok: false, error: 'Upgrade already at maximum level.' });
  }

  const cost = Math.round(upg.baseCost * Math.pow(upg.costScale, currentLevel));
  if (gameState.money < cost) {
    return res.status(400).json({ ok: false, error: 'Insufficient funds for this upgrade.' });
  }

  gameState.money -= cost;
  gameState.upgrades[upgradeId] = currentLevel + 1;

  if (upgradeId === 'capacity_1' || upgradeId === 'expansion_1') {
    const spec = BUSINESS_CATALOG[gameState.businessType];
    const stageMult = STAGE_REQUIREMENTS[gameState.stage - 1].capacityMult;
    const bonus = 1 + (gameState.upgrades.capacity_1 * 0.25) + (gameState.upgrades.expansion_1 * 0.15);
    gameState.maxInventory = Math.round(spec.maxInventoryBase * stageMult * bonus);
  }

  persistAutoSave();
  res.json({ ok: true, cost, state: gameState });
});

app.post('/api/hire', (req, res) => {
  const { roleId, customName, customWage, shift } = req.body || {};
  if (!gameState.started) {
    return res.status(400).json({ ok: false, error: 'Choose a business first.' });
  }

  const role = STAFF_ROLES[roleId];
  if (!role) {
    return res.status(400).json({ ok: false, error: 'Invalid staff role.' });
  }

  if (gameState.stage < role.minStage) {
    return res.status(400).json({ ok: false, error: `${role.name} unlocks at Stage ${role.minStage}.` });
  }

  const maxStaff = STAGE_REQUIREMENTS[gameState.stage - 1].maxStaff + (gameState.upgrades.expansion_1 || 0);
  if (gameState.workers.length >= maxStaff) {
    return res.status(400).json({ ok: false, error: `Staff capacity reached (${maxStaff}). Expand your space first.` });
  }

  if (gameState.money < role.hireCost) {
    return res.status(400).json({ ok: false, error: 'Insufficient funds for hiring fee.' });
  }

  gameState.money -= role.hireCost;
  const worker = {
    id: `w_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`,
    roleId: role.id,
    roleName: role.name,
    tier: role.tier,
    name: customName || WORKER_NAMES[Math.floor(Math.random() * WORKER_NAMES.length)],
    skill: 1,
    rank: 'Junior',
    wage: Number(customWage) || role.baseWage,
    baseWage: role.baseWage,
    energy: 100,
    happiness: 82,
    shift: shift || 'full'
  };

  gameState.workers.push(worker);
  persistAutoSave();
  res.json({ ok: true, worker, state: gameState });
});

app.post('/api/fire', (req, res) => {
  const { workerId } = req.body || {};
  const idx = gameState.workers.findIndex((w) => w.id === workerId);
  if (idx === -1) {
    return res.status(404).json({ ok: false, error: 'Worker not found.' });
  }
  const [removed] = gameState.workers.splice(idx, 1);
  persistAutoSave();
  res.json({ ok: true, removed, state: gameState });
});

app.post('/api/staff-manage', (req, res) => {
  const { workerId, action, wage, shift } = req.body || {};
  const worker = gameState.workers.find((w) => w.id === workerId);
  if (!worker) {
    return res.status(404).json({ ok: false, error: 'Worker not found.' });
  }

  if (action === 'set_wage') {
    const newWage = Math.max(20, Math.min(2000, Number(wage) || worker.wage));
    worker.wage = newWage;
    if (newWage >= worker.baseWage * 1.2) {
      worker.happiness = Math.min(100, worker.happiness + 8);
    } else if (newWage < worker.baseWage * 0.8) {
      worker.happiness = Math.max(10, worker.happiness - 12);
    }
  } else if (action === 'set_shift') {
    if (['morning', 'peak', 'evening', 'full'].includes(shift)) {
      worker.shift = shift;
    }
  } else if (action === 'train') {
    if (worker.skill >= 10) {
      return res.status(400).json({ ok: false, error: 'Worker already at max skill level.' });
    }
    const trainCost = Math.round(110 * Math.pow(1.45, worker.skill - 1));
    if (gameState.money < trainCost) {
      return res.status(400).json({ ok: false, error: 'Not enough funds to train this worker.' });
    }
    gameState.money -= trainCost;
    worker.skill += 1;
    worker.happiness = Math.min(100, worker.happiness + 6);
  } else if (action === 'promote') {
    const ranks = ['Junior', 'Senior', 'Lead'];
    const currentIdx = ranks.indexOf(worker.rank || 'Junior');
    if (currentIdx >= ranks.length - 1) {
      return res.status(400).json({ ok: false, error: 'Worker already at Lead rank.' });
    }
    const promoCost = (currentIdx + 1) * 280;
    if (gameState.money < promoCost) {
      return res.status(400).json({ ok: false, error: 'Insufficient funds for promotion bonus.' });
    }
    gameState.money -= promoCost;
    worker.rank = ranks[currentIdx + 1];
    worker.wage = Math.round(worker.wage * 1.25);
    worker.happiness = Math.min(100, worker.happiness + 15);
  }

  persistAutoSave();
  res.json({ ok: true, worker, state: gameState });
});

app.post('/api/set-price', (req, res) => {
  const { priceMultiplier } = req.body || {};
  const val = Number(priceMultiplier);
  if (Number.isNaN(val) || val < 0.5 || val > 2.0) {
    return res.status(400).json({ ok: false, error: 'Price multiplier must be between 0.50 and 2.00.' });
  }
  gameState.priceMultiplier = Number(val.toFixed(2));
  persistAutoSave();
  res.json({ ok: true, priceMultiplier: gameState.priceMultiplier, state: gameState });
});

app.post('/api/set-hours', (req, res) => {
  const { openHour, closeHour } = req.body || {};
  const open = Math.max(5, Math.min(14, Number(openHour)));
  const close = Math.max(open + 3, Math.min(24, Number(closeHour)));
  if (Number.isNaN(open) || Number.isNaN(close)) {
    return res.status(400).json({ ok: false, error: 'Invalid business hours.' });
  }
  gameState.openHour = open;
  gameState.closeHour = close;
  persistAutoSave();
  res.json({ ok: true, openHour: open, closeHour: close, state: gameState });
});

app.post('/api/restock', (req, res) => {
  const { amount } = req.body || {};
  if (!gameState.started || !gameState.businessType) {
    return res.status(400).json({ ok: false, error: 'Choose a business first.' });
  }
  const spec = BUSINESS_CATALOG[gameState.businessType];
  const spaceLeft = Math.max(0, gameState.maxInventory - gameState.inventory);
  if (spaceLeft <= 0) {
    return res.status(400).json({ ok: false, error: 'Storage is already full.' });
  }

  const desired = amount === 'full' ? spaceLeft : Math.min(spaceLeft, Math.max(1, Number(amount) || 25));
  const invMgrCount = gameState.workers.filter((w) => w.roleId === 'inventory_manager').length;
  const discount = Math.min(0.35, invMgrCount * 0.18);
  const unitCost = Math.max(0.5, (spec.unitCost || 4) * (1 - discount));
  const totalCost = Math.round(desired * unitCost);

  if (gameState.money < totalCost) {
    return res.status(400).json({ ok: false, error: `Restock costs $${totalCost.toLocaleString()}. Insufficient funds.` });
  }

  gameState.money -= totalCost;
  gameState.inventory = Math.min(gameState.maxInventory, gameState.inventory + desired);
  gameState.todayStats.cogs += totalCost;
  persistAutoSave();
  res.json({ ok: true, added: desired, cost: totalCost, state: gameState });
});

app.post('/api/prestige', (_req, res) => {
  if (!gameState.started) {
    return res.status(400).json({ ok: false, error: 'Start a business before prestiging.' });
  }
  const nextLevel = gameState.prestigeLevel + 1;
  if (nextLevel >= PRESTIGE_MULTIPLIERS.length) {
    return res.status(400).json({ ok: false, error: 'Maximum 100x Prestige Multiplier already reached.' });
  }

  const requiredStage = Math.min(5, 2 + gameState.prestigeLevel);
  if (gameState.stage < requiredStage && gameState.totalEarned < 25000 * Math.pow(3, gameState.prestigeLevel)) {
    return res.status(400).json({
      ok: false,
      error: `Reach Stage ${requiredStage} or $${(25000 * Math.pow(3, gameState.prestigeLevel)).toLocaleString()} total earnings to Prestige.`
    });
  }

  const nextMult = PRESTIGE_MULTIPLIERS[nextLevel];
  const preservedLifetime = (gameState.lifetimeEarnings || 0) + (gameState.totalEarned || 0);
  const preservedMilestones = gameState.milestones || [];

  gameState = createInitialState();
  gameState.prestigeLevel = nextLevel;
  gameState.prestigeMultiplier = nextMult;
  gameState.lifetimeEarnings = preservedLifetime;
  gameState.milestones = preservedMilestones;

  persistAutoSave();
  res.json({ ok: true, prestigeMultiplier: nextMult, state: gameState });
});

app.post('/api/sync', (req, res) => {
  const { state } = req.body || {};
  if (!state || typeof state !== 'object') {
    return res.status(400).json({ ok: false, error: 'Invalid sync payload.' });
  }
  gameState = { ...createInitialState(), ...state, lastSavedAt: new Date().toISOString() };
  persistAutoSave();
  res.json({ ok: true, state: gameState });
});

app.get('/api/save', (_req, res) => {
  persistAutoSave();
  res.setHeader('Content-Type', 'application/json');
  res.setHeader('Content-Disposition', 'attachment; filename="edgeflow-empire-save.json"');
  res.send(JSON.stringify(gameState, null, 2));
});

app.post('/api/load', (req, res) => {
  const payload = req.body?.state || req.body;
  if (!payload || typeof payload !== 'object' || typeof payload.money !== 'number') {
    return res.status(400).json({ ok: false, error: 'Invalid save JSON format.' });
  }
  gameState = { ...createInitialState(), ...payload, lastSavedAt: new Date().toISOString() };
  persistAutoSave();
  res.json({ ok: true, state: gameState });
});

app.listen(PORT, '0.0.0.0', () => {
  console.log('EdgeFlow Empire — Server Running on Port 3000');
});
